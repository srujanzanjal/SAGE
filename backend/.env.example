# Supabase project URL
SUPABASE_URL=
# Supabase service role key or anon key depending on local setup
SUPABASE_KEY=
# Gemini API key (primary LLM, free tier at aistudio.google.com)
GEMINI_API_KEY=
# Groq API key (automatic fallback when Gemini is rate-limited)
GROQ_API_KEY=
# Optional: models, tried in order; each free-tier model has its own quota
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Set true only if query history should be stored
STORE_QUERY_HISTORY=false
# Whisper model size for video auto-transcription: tiny, base, small
WHISPER_MODEL_SIZE=tiny
