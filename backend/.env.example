# Supabase project URL
SUPABASE_URL=
# Supabase service role key or anon key depending on local setup
SUPABASE_KEY=
# Groq API key for LLM responses
GROQ_API_KEY=
# Set true only if query history should be stored
STORE_QUERY_HISTORY=false
# Whisper model size for video auto-transcription: tiny, base, small
WHISPER_MODEL_SIZE=tiny
