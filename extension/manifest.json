{
  "manifest_version": 3,
  "name": "SAGE Side Panel",
  "description": "Reads your current tab and analyzes it with the local SAGE backend as a website, YouTube video, or GitHub repository.",
  "version": "1.7.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open SAGE Side Panel"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
