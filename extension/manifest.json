{
  "manifest_version": 3,
  "name": "SAGE Website Side Panel",
  "description": "Analyze the current website with the local SAGE backend.",
  "version": "1.6.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open SAGE Website Panel"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
